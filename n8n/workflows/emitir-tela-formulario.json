              "id": "5b170c52-296a-4c17-ba5b-08192a3b4c5d",
              "name": "html",
              "type": "string",
              "value": "=<!doctype html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Novo documento</title>\n<style>:root { --cor: {{ $json.cor }}; } {{ $json.css }}\nform { display: grid; gap: 14px; }\nlabel { display: grid; gap: 4px; font-weight: 600; font-size: .9rem; }\nlabel span { font-weight: 400; color: #6b6880; font-size: .82rem; }\ninput, select { width: 100%; padding: 10px 12px; font: 1rem system-ui, sans-serif; border: 1px solid #cfcbe0; border-radius: 8px; background: #fff; }\n.dupla { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }\n.decl, .sem { display: none; }\nform:has(option[value=\"certificado_semestre\"]:checked) .sem { display: grid; }\nform:has(option[value^=\"declaracao\"]:checked) .decl { display: grid; }\nform:has(option[value^=\"declaracao\"]:checked) .cert-obrig { display: none; }\nfieldset { border: 1px dashed #cfcbe0; border-radius: 8px; padding: 12px; margin: 0; gap: 14px; }\nlegend { font-size: .85rem; color: #6b6880; padding: 0 4px; }\n.acoes { display: flex; gap: 12px; justify-content: flex-end; flex-wrap: wrap; }\n@media (max-width: 560px) { .dupla { grid-template-columns: 1fr; } .acoes .btn { flex: 1; text-align: center; } }\n</style>\n</head>\n<body>\n<header class=\"topo\"><div>{{ $json.logo_url ? '<img src=\"' + $json.logo_url + '\" alt=\"\">' : '' }}<b>Emissão de documentos</b><small>{{ $json.email }}</small></div></header>\n<main>\n{{ $json.erro ? '<div class=\"erro\">' + $json.erro + '</div>' : '' }}\n<div class=\"card\">\n  <h1>Novo documento</h1>\n  <p class=\"muted\">Os dados vão para a planilha e o documento ganha um ID de validação. Depois é só baixar o PDF. Vários de uma vez? <a href=\"?importar\">Importe um CSV</a>.</p>\n  <form method=\"post\" action=\"\"><input type=\"hidden\" name=\"csrf\" value=\"{{ $json.csrf }}\">\n    <label>Tipo de documento\n      <select name=\"tipo_documento\" required><option value=\"\">Escolha…</option>{{ $json.tipos.map(t => `<option value=\"${t.valor}\"${t.valor === $json.valores.tipo_documento ? ' selected' : ''}>${t.nome}</option>`).join('') }}</select></label>\n    <label>Nome completo do aluno<input name=\"nome\" value=\"{{ $json.valores.nome }}\" required maxlength=\"200\"></label>\n    <label>Curso<span>Ex.: Inglês</span><input name=\"curso\" value=\"{{ $json.valores.curso }}\" required maxlength=\"200\"></label>\n    <div class=\"dupla\">\n      <label>Carga horária<span class=\"cert-obrig\">Em horas (obrigatória no certificado)</span><span class=\"decl\">Em horas (opcional)</span><input name=\"carga_horaria\" value=\"{{ $json.valores.carga_horaria }}\" inputmode=\"numeric\" pattern=\"[0-9]*\" maxlength=\"4\"></label>\n      <label>Data de emissão<input type=\"date\" name=\"data_emissao\" value=\"{{ $json.valores.data_emissao }}\" required></label>\n    </div>\n    <label class=\"sem\">Página de conteúdo<span>Opcional: inclui o conteúdo de um semestre numa segunda página</span>\n      <select name=\"semestre_conteudo\"><option value=\"\">Não incluir</option>{{ $json.semestres.map(t => `<option${t === $json.valores.semestre_conteudo ? ' selected' : ''}>${t}</option>`).join('') }}</select></label>\n    <fieldset class=\"decl\"><legend>Só nas declarações (não aparecem na validação pública)</legend>\n      <div class=\"dupla\">\n        <label>CPF<input name=\"cpf\" value=\"{{ $json.valores.cpf }}\" maxlength=\"20\"></label>\n        <label>RG<input name=\"rg\" value=\"{{ $json.valores.rg }}\" maxlength=\"20\"></label>\n      </div>\n      <label>Endereço<span>Rua, número, bairro, cidade/UF</span><input name=\"endereco\" value=\"{{ $json.valores.endereco }}\" maxlength=\"200\"></label>\n      <label>Dia de aula<span>Opcional. Ex.: terças e quintas, 19h</span><input name=\"dia_aula\" value=\"{{ $json.valores.dia_aula }}\" maxlength=\"100\"></label>\n    </fieldset>\n    <div class=\"acoes\"><a class=\"btn claro\" href=\"?\">Cancelar</a><button class=\"btn\" type=\"submit\">Cadastrar</button></div>\n  </form>\n</div>\n</main>\n</body>\n</html>\n"
            }
