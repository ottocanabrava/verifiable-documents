    {
      "parameters": {
        "jsCode": "// ===== Configuração (preencha no seu n8n; nunca no repositório) =====\nconst URL_VALIDACAO = 'https://exemplo.com/webhook/validar';  // endereço público da validação\nconst MODELO_CERTIFICADO = '';  // ID do modelo no Google Slides\nconst MODELO_DECLARACAO = '';\n// ponytail: o QR é desenhado por um serviço externo, que vê a URL de validação\n// (só o ID, nenhum dado do aluno). Se precisar evitar, trocar por um gerador próprio.\nconst QR_API = 'https://api.qrserver.com/v1/create-qr-code/?size=600x600&margin=0&data=';\n// ====================================================================\n\n// Decide o que fazer com o pedido e devolve só dados; o HTML das telas fica no\n// subfluxo \"Emitir documento: telas\" (valores de texto já escapados aqui).\nconst TIPOS = {\n  certificado_curso: 'Certificado de conclusão de curso',\n  certificado_semestre: 'Certificado de conclusão de semestre',\n  certificado_trimestre: 'Certificado de conclusão de trimestre',\n  declaracao_matricula: 'Declaração de matrícula',\n  declaracao_termino_semestre: 'Declaração de término de semestre',\n};\nconst OBRIGATORIOS = {\n  certificado_semestre: ['nome', 'curso', 'carga_horaria'],\n  certificado_trimestre: ['nome', 'curso', 'carga_horaria'],\n  declaracao_matricula: ['nome', 'curso', 'cpf', 'rg', 'endereco'],\n  declaracao_termino_semestre: ['nome', 'curso', 'cpf', 'rg', 'endereco'],\n};\nconst CAMPOS = { nome: 'nome', curso: 'curso', carga_horaria: 'carga horária', data_emissao: 'data de emissão',\n  cpf: 'CPF', rg: 'RG', endereco: 'endereço', dia_aula: 'dia de aula' };\nconst MESES = ['janeiro', 'fevereiro', 'março', 'abril', 'maio', 'junho', 'julho',\n  'agosto', 'setembro', 'outubro', 'novembro', 'dezembro'];\n\nconst esc = v => String(v ?? '').replace(/[&<>\"']/g, c =>\n  ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c]);\nconst txt = v => String(v ?? '').trim();\nconst ID = /^[A-Za-z0-9]{12}$/;\n\nfunction data(valor) {  // 'AAAA-MM-DD' ou 'DD/MM/AAAA' -> {d, m, a}, ou null\n  let x = txt(valor).match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n  const [a, m, d] = x ? [+x[1], +x[2], +x[3]]\n    : (x = txt(valor).match(/^(\\d{2})\\/(\\d{2})\\/(\\d{4})$/)) ? [+x[3], +x[2], +x[1]] : [];\n  const dt = new Date(Date.UTC(a, m - 1, d));\n  return x && dt.getUTCMonth() === m - 1 && dt.getUTCDate() === d ? { d, m, a } : null;\n}\nconst dois = n => String(n).padStart(2, '0');\n\nconst pedido = $('Autorizar (subfluxo)').first().json;\nconst q = pedido.query || {};\nconst corpo = pedido.body || {};\nconst novoId = txt($('Gerar ID').first().json.novo_id).replace(/[^A-Za-z0-9]/g, '').slice(0, 12);\nconst entrada = $input.all().map(i => i.json);\nconst linhas = entrada.filter(r => r.row_number);\nconst contagem = {};\nfor (const r of linhas) contagem[txt(r.id)] = (contagem[txt(r.id)] || 0) + 1;\n\nfunction problema(r) {\n  if (!txt(r.id)) return '';\n  if (!ID.test(txt(r.id))) return 'ID inválido';\n  return contagem[txt(r.id)] > 1 ? 'ID duplicado' : '';\n}\nconst base = { acao: 'pagina', email: esc(pedido.email) };\n\nfunction lista(status, erro, criado) {\n  const docs = linhas.slice().reverse().map(r => ({\n    nome: esc(r.nome), tipo: esc(TIPOS[txt(r.tipo_documento)] || r.tipo_documento), curso: esc(r.curso),\n    data: esc(r.data_emissao), status: esc(r.status), ativo: txt(r.status).toLowerCase() === 'ativo',\n    problema: esc(problema(r)),\n    href: esc('?' + (txt(r.id) ? 'id=' + encodeURIComponent(txt(r.id)) : 'linha=' + r.row_number)),\n  }));\n  const novo = criado && linhas.find(r => txt(r.id) === criado);\n  return [{ json: { ...base, tela: 'lista', status, erro: esc(erro), docs,\n    criado: novo ? { nome: esc(novo.nome), href: esc('?id=' + encodeURIComponent(criado)) } : null } }];\n}\n\n// Hoje em Brasília (UTC-3, sem horário de verão desde 2019), para a data padrão do formulário.\nconst hoje = new Date(Date.now() - 3 * 3600000).toISOString().slice(0, 10);\nfunction formulario(status, erro, valores) {\n  const tipos = Object.keys(OBRIGATORIOS).map(v => ({ valor: v, nome: TIPOS[v] }));\n  const val = {};\n  for (const k of ['tipo_documento', ...Object.keys(CAMPOS)]) val[k] = esc(valores[k]);\n  return [{ json: { ...base, tela: 'formulario', status, erro: esc(erro), tipos, valores: val } }];\n}\n\nif (entrada.some(r => r.error)) return lista(503, 'Não foi possível ler a planilha agora. Tente de novo em alguns minutos.');\n\n// Cadastro de um documento novo (formulário): grava a linha com ID novo e volta para a lista.\nif (corpo.tipo_documento !== undefined) {\n  const v = {};\n  for (const k of ['tipo_documento', ...Object.keys(CAMPOS)]) v[k] = txt(corpo[k]).slice(0, 200);\n  const falha = m => formulario(422, m, v);\n  const tipo = v.tipo_documento;\n  if (!OBRIGATORIOS[tipo]) return falha('Escolha o tipo de documento.');\n  const faltando = ['data_emissao', ...OBRIGATORIOS[tipo]].filter(k => !v[k]);\n  if (faltando.length) return falha(`Preencha: ${faltando.map(k => CAMPOS[k]).join(', ')}.`);\n  const d = data(v.data_emissao);\n  if (!d) return falha('Data de emissão inválida.');\n  if (v.carga_horaria && !/^\\d{1,4}$/.test(v.carga_horaria)) return falha('Carga horária: só números (horas).');\n  if (!ID.test(novoId) || contagem[novoId]) return falha('Falha ao gerar o ID. Tente de novo.');\n  const declaracao = tipo.startsWith('declaracao_');\n  const linha = { id: novoId, tipo_documento: tipo, nome: v.nome, curso: v.curso, carga_horaria: v.carga_horaria,\n    data_emissao: `${dois(d.d)}/${dois(d.m)}/${d.a}`, status: 'ativo',\n    cpf: declaracao ? v.cpf : '', rg: declaracao ? v.rg : '', endereco: declaracao ? v.endereco : '',\n    dia_aula: declaracao ? v.dia_aula : '' };\n  return [{ json: { acao: 'cadastrar', linha, location: '?criado=' + novoId } }];\n}\n\nif (q.novo !== undefined) return formulario(200, '', { data_emissao: hoje });\nif (!q.id && !q.linha) return lista(200, '', txt(q.criado));\n\n// Linha escolhida: pelo ID (tem de ser único) ou pelo número da