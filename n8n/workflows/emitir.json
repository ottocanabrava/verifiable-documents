: {\n  TITULO: tipo === 'declaracao_matricula' ? 'DECLARAÇÃO DE MATRÍCULA' : 'DECLARAÇÃO DE TÉRMINO DE SEMESTRE',\n  abertura: tipo === 'declaracao_matricula' ? 'declara, para os fins que sejam necessários, que' : 'declara que o semestre de',\n  NOME: txt(r.nome).toUpperCase(),\n  cpf: txt(r.cpf),\n  rg: txt(r.rg),\n  ENDERECO: txt(r.endereco).toUpperCase(),\n  situacao: tipo === 'declaracao_matricula' ? 'está devidamente matriculado(a) no' : 'foi concluído no',\n  curso_destaque: tipo === 'declaracao_matricula' ? `curso de ${curso}` : `CURSO DE ${curso.toUpperCase()}`,\n  extras: extras.length ? ', ' + extras.join(' e ') : '',\n};\ntextos.data = `${d.d} de ${MESES[d.m - 1]} de ${d.a}`;\ntextos.id = id;\n\n// Pedidos para a API do Slides: troca cada {{marcador}} e a caixa {{qr}} pela imagem.\nconst requests = Object.entries(textos).map(([k, v]) => ({\n  replaceAllText: { containsText: { text: `{{${k}}}`, matchCase: true }, replaceText: v },\n}));\nrequests.push({ replaceAllShapesWithImage: {\n  containsText: { text: '{{qr}}', matchCase: true },\n  imageUrl: QR_API + encodeURIComponent(`${URL_VALIDACAO}?id=${id}`),\n  imageReplaceMethod: 'CENTER_INSIDE',\n} });\n\n// Nome do arquivo para o Content-Disposition: sem controles, invisíveis, aspas nem barras.\nconst arquivo = `${TIPOS[tipo]} - ${txt(r.nome)}`\n  .replace(/[\\u0000-\\u001f\\u007f-\\u009f​-‏‪-‮⁦-⁩/\\\\\"]/g, '')\n  .replace(/\\s+/g, ' ').trim() + '.pdf';\nconst ascii = arquivo.normalize('NFD').replace(/[^\\x20-\\x7e]/g, '');\nconst disposicao = `attachment; filename=\"${ascii}\"; filename*=UTF-8''${encodeURIComponent(arquivo)\n  .replace(/['()*]/g, c => '%' + c.charCodeAt(0).toString(16).toUpperCase())}`;\n\nreturn [{ json: { acao: 'pdf', row_number: r.row_number, id, id_novo: idNovo, modelo, copia: `Emissão ${id}`,\n  arquivo, disposicao, requests } }];\n"
