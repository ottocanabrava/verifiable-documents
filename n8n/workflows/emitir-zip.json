{
  "name": "Emitir documento: pacote ZIP",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "name": "Chamado pelo fluxo de emissão",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Cada PDF entra no ZIP com o nome decidido pelo Preparar documento.\nreturn $input.all().map(item => {\n  item.binary.data.fileName = item.json.arquivo;\n  return { json: {}, binary: item.binary };\n});"
      },
      "name": "Dar nome aos PDFs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "pdfs",
        "options": {
          "includeBinaries": true
        }
      },
      "name": "Juntar",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "operation": "compress",
        "binaryPropertyName": "={{ Object.keys($binary).join(',') }}",
        "outputFormat": "zip",
        "fileName": "documentos.zip",
        "binaryPropertyOutput": "data"
      },
      "name": "Compactar",
      "type": "n8n-nodes-base.compression",
      "typeVersion": 1.1,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {
    "Chamado pelo fluxo de emissão": {
      "main": [
        [
          {
            "node": "Dar nome aos PDFs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dar nome aos PDFs": {
      "main": [
        [
          {
            "node": "Juntar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Juntar": {
      "main": [
        [
          {
            "node": "Compactar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false
  }
}
