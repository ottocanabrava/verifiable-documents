# Credencial da service account do Google (use UMA das duas opções).
# Opção 1: caminho para o arquivo JSON, FORA do repositório.
GOOGLE_SERVICE_ACCOUNT_FILE=/caminho/fora/do/repo/service-account.json
# Opção 2: o conteúdo do JSON inteiro numa única linha.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID da planilha (o trecho entre /d/ e /edit na URL) e nome da aba.
SHEET_ID=
SHEET_TAB=Certificados

# URL pública base da página de validação (usada no QR code).
VALIDATION_BASE_URL=https://exemplo.com/validar

# Dados do emissor (usados no PDF e no link do LinkedIn).
ISSUER_NAME=Escola Exemplo
LINKEDIN_ORGANIZATION_ID=
