# Acesso às planilhas: credencial padrão do Google, sem chave no projeto
# (identidade do ambiente, ou login local da CLI do Google). Se precisar de
# um arquivo de credencial, deixe-o FORA do repositório:
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/fora/do/repo/credencial.json

# 1 quando o serviço roda atrás de um proxy reverso (HTTPS), para o rate
# limit usar o IP real do visitante.
TRUST_PROXY=0

# IDs das planilhas (o trecho entre /d/ e /edit na URL); lê a primeira aba.
# Documentos: uma linha por documento emitido.
SHEET_ID=
# Conteúdo de cada curso (colunas: curso | semestre | item).
CONTEUDOS_SHEET_ID=

# URL pública base da página de validação (usada no QR code).
VALIDATION_BASE_URL=https://exemplo.com/validar

# Dados do emissor, impressos nos documentos.
ISSUER_NOME=Escola Exemplo de Idiomas
ISSUER_EMAIL=contato@exemplo.com.br
ISSUER_SITE=www.exemplo.com.br
ISSUER_RAZAO_SOCIAL=Escola Exemplo Ltda
ISSUER_CNPJ=00.000.000/0001-00
ISSUER_CIDADE=Cidade/UF
ISSUER_ENDERECO=Rua Exemplo, 100, Bairro: Centro, CEP 00.000-000
ISSUER_SIGNATARIO=Nome do Signatário
ISSUER_CARGO=Diretora Pedagógica
# Imagens do emissor: caminhos FORA do repositório (opcionais).
ISSUER_LOGO=
# Versão branca/clara do logo, para o fundo roxo do certificado.
ISSUER_LOGO_BRANCO=
ISSUER_ASSINATURA=

# Senha da área de emissão /emitir (sem ela, a área fica desligada).
ADMIN_PASSWORD=
